<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Amber.MacOS.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="780"
        x:Class="Amber.MacOS.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/Amber.ico"
        Title="Amber"
        Width="680"
        Height="780"
        MinWidth="560"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*">
        <Border Padding="28,22" Background="{DynamicResource ThemeAccent}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Text="Amber" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource ThemeOnAccentText}" />
                    <TextBlock Text="Brightness and color temperature" FontSize="13" Foreground="White" Opacity="0.82" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Padding="10,5" CornerRadius="4" Background="#22000000">
                    <TextBlock Text="macOS" FontWeight="SemiBold" Foreground="White" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="28" Spacing="16">
                <Border Classes="section">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="sectionTitle" Text="Displays" />
                            <Button Grid.Column="1" Command="{Binding RefreshCommand}" Content="Refresh" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Displays}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4" ColumnDefinitions="12,*,Auto">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource ThemeAccent}" />
                                        <StackPanel Grid.Column="1" Margin="10,0" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Classes="caption" Text="{Binding CapabilitySummary}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Classes="caption" VerticalAlignment="Center" Text="{Binding Identifier}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock IsVisible="{Binding HasNoDisplays}" Classes="caption" Text="No active displays were reported." />
                    </StackPanel>
                </Border>

                <Border Classes="section">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="sectionTitle" Text="Brightness" />
                            <TextBlock Grid.Column="1" Text="{Binding Brightness, StringFormat={}{0}%}" FontWeight="SemiBold" />
                        </Grid>
                        <Slider Minimum="1" Maximum="100" TickFrequency="1"
                                IsEnabled="{Binding HasBrightnessSupport}"
                                Value="{Binding Brightness}" />
                        <TextBlock Classes="caption" Text="{Binding BrightnessStatus}" />
                    </StackPanel>
                </Border>

                <Border Classes="section">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="sectionTitle" Text="Color temperature" />
                            <TextBlock Grid.Column="1" Text="{Binding ColorTemperature, StringFormat={}{0} K}" FontWeight="SemiBold" />
                        </Grid>
                        <Slider Minimum="900" Maximum="6600" TickFrequency="100"
                                IsEnabled="{Binding ManualColorEnabled}"
                                Value="{Binding ColorTemperature}" />
                        <ToggleSwitch Content="Automatic (time based)" IsChecked="{Binding AutoColorTemperature}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <StackPanel Spacing="5">
                                <TextBlock Classes="caption" Text="DAY TARGET" />
                                <Slider Minimum="900" Maximum="6600" TickFrequency="100" Value="{Binding DayColorTemp}" />
                                <TextBlock Text="{Binding DayColorTemp, StringFormat={}{0} K}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Classes="caption" Text="NIGHT TARGET" />
                                <Slider Minimum="900" Maximum="6600" TickFrequency="100" Value="{Binding NightColorTemp}" />
                                <TextBlock Text="{Binding NightColorTemp, StringFormat={}{0} K}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="caption" Text="MORNING" />
                                <TextBox Text="{Binding MorningStart}" PlaceholderText="06:00" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="caption" Text="TO" />
                                <TextBox Text="{Binding MorningEnd}" PlaceholderText="07:00" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Classes="caption" Text="EVENING" />
                                <TextBox Text="{Binding EveningStart}" PlaceholderText="17:30" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="4">
                                <TextBlock Classes="caption" Text="TO" />
                                <TextBox Text="{Binding EveningEnd}" PlaceholderText="18:30" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="caption" Text="{Binding ColorStatus}" />
                    </StackPanel>
                </Border>

                <Border Classes="section">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="sectionTitle" Text="Appearance" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <StackPanel Spacing="5">
                                <TextBlock Classes="caption" Text="LIGHT MODE" />
                                <ComboBox ItemsSource="{Binding LightThemes}" SelectedItem="{Binding LightModeTheme}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Classes="caption" Text="DARK MODE" />
                                <ComboBox ItemsSource="{Binding DarkThemes}" SelectedItem="{Binding DarkModeTheme}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</Window>
