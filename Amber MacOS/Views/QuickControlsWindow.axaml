<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Amber.MacOS.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="310"
        x:Class="Amber.MacOS.Views.QuickControlsWindow"
        x:DataType="vm:MainViewModel"
        Title="Amber controls"
        Width="340"
        Height="310"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Mica,Blur,None">

    <Border Background="{DynamicResource ThemeWindowBackground}"
            BorderBrush="{DynamicResource ThemeBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="20">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="18">
            <StackPanel Spacing="9">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Brightness" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Brightness, StringFormat={}{0}%}" FontWeight="SemiBold" />
                </Grid>
                <Slider Minimum="1" Maximum="100" TickFrequency="1"
                        IsEnabled="{Binding HasBrightnessSupport}"
                        Value="{Binding Brightness}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="9">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Color temperature" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding ColorTemperature, StringFormat={}{0} K}" FontWeight="SemiBold" />
                </Grid>
                <Slider Minimum="900" Maximum="6600" TickFrequency="100"
                        IsEnabled="{Binding ManualColorEnabled}"
                        Value="{Binding ColorTemperature}" />
                <ToggleSwitch HorizontalAlignment="Left"
                              IsChecked="{Binding AutoColorTemperature}"
                              Content="Automatic color" />
            </StackPanel>

            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button Command="{Binding ShowWindowCommand}" Content="Settings" />
                <Button Grid.Column="2" Command="{Binding QuitCommand}" Content="Quit" />
            </Grid>
        </Grid>
    </Border>
</Window>