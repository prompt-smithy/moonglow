<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>DisplayController</RootNamespace>
    <AssemblyName>DisplayController</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Display Controller</Product>
    <AssemblyTitle>Display Controller</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <!-- Single command that builds all four distributables (portable + installer,
       each in self-contained and framework-dependent flavors). Run with:
         dotnet build -t:PackageAll
       Optionally override the runtime:
         dotnet build -t:PackageAll -p:PackageRuntime=win-arm64 -->
  <Target Name="PackageAll">
    <PropertyGroup>
      <PackageRuntime Condition="'$(PackageRuntime)' == ''">win-x64</PackageRuntime>
    </PropertyGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build.ps1&quot; -Runtime $(PackageRuntime)" />
  </Target>

</Project>
