# Maintainer: Thomas Martin <tmmuttathara@gmail.com>
# Release flow: tag v$pkgver upstream, then refresh the checksum with
# `updpkgsums` (or `makepkg -g`) and regenerate .SRCINFO before pushing to AUR.
pkgname=moonglow
pkgver=1.0.1
pkgrel=1
pkgdesc="Desktop app for external-display DDC/CI brightness and scheduled colour temperature"
arch=('x86_64' 'aarch64')
url="https://github.com/prompt-smithy/moonglow"
license=('MIT' 'Apache-2.0')
depends=('gcc-libs')
makedepends=('cargo')
optdepends=('i2c-tools: DDC/CI brightness debugging (i2cdetect)')
install=moonglow.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('REPLACE_AFTER_TAG')

build() {
    cd "moonglow-$pkgver/apps/linux"
    cargo build --release --locked -p moonglow
}

package() {
    cd "moonglow-$pkgver/apps/linux"
    install -Dm755 "target/release/moonglow" "$pkgdir/usr/bin/moonglow"
    install -Dm644 "packaging/moonglow.desktop" "$pkgdir/usr/share/applications/moonglow.desktop"
    install -Dm644 "packaging/moonglow.metainfo.xml" "$pkgdir/usr/share/metainfo/io.github.prompt-smithy.moonglow.metainfo.xml"
    for size in 16 24 32 48 64 128 256 512; do
        install -Dm644 "../../resources/linux/hicolor/${size}x${size}/apps/moonglow.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/moonglow.png"
    done
    install -Dm644 "packaging/51-moonglow-i2c.rules" "$pkgdir/usr/lib/udev/rules.d/51-moonglow-i2c.rules"
    install -Dm644 "packaging/moonglow.1" "$pkgdir/usr/share/man/man1/moonglow.1"
    gzip -9 "$pkgdir/usr/share/man/man1/moonglow.1"
}
