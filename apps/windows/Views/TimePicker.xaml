<UserControl x:Class="Moonglow.Views.TimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <ComboBox x:Name="HourCombo" Width="54" MaxDropDownHeight="220"
                  SelectionChanged="Part_SelectionChanged" PreviewMouseWheel="Combo_PreviewMouseWheel" />
        <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0" FontSize="15" FontWeight="Bold"
                   Foreground="{DynamicResource ThemePrimaryText}" />
        <ComboBox x:Name="MinuteCombo" Width="54" MaxDropDownHeight="220"
                  SelectionChanged="Part_SelectionChanged" PreviewMouseWheel="Combo_PreviewMouseWheel" />
        <ComboBox x:Name="AmPmCombo" Width="58" Margin="8,0,0,0" MaxDropDownHeight="220"
                  SelectionChanged="Part_SelectionChanged" PreviewMouseWheel="Combo_PreviewMouseWheel" />
    </StackPanel>
</UserControl>
