<Window x:Class="Moonglow.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Moonglow.Views"
        xmlns:core="clr-namespace:Moonglow.Core;assembly=Moonglow.Core"
        Title="Moonglow" Height="680" Width="470"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource ThemeWindowBackground}"
        ResizeMode="CanMinimize"
        PreviewMouseDown="OnMouseActivity" PreviewMouseMove="OnMouseActivity"
        PreviewMouseWheel="OnMouseActivity" PreviewKeyDown="OnKeyboardActivity"
        PreviewTouchDown="OnTouchActivity">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryText}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ThemePrimaryText}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryText}" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackground}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,8,22,20">
        <StackPanel>
            <TextBlock Text="Set the automatic color temperature range and daily transition times. Use the tray slider for manual adjustments."
                       Foreground="{DynamicResource ThemeSecondaryText}" Margin="0,2,0,0" TextWrapping="Wrap" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Follow color temperature schedule" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                              ToolTip="Change color temperature gradually using the daily schedule"
                              IsChecked="{Binding AutoColorTemperature, Mode=TwoWay}" />
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="COLOR TEMPERATURE RANGE" FontSize="11"
                           FontWeight="SemiBold" Foreground="{DynamicResource ThemeSecondaryText}" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold">
                    <Run Text="{Binding NightColorTemp, StringFormat={}{0} K}" />
                    <Run Text=" - " />
                    <Run Text="{Binding DayColorTemp, StringFormat={}{0} K}" />
                </TextBlock>
            </Grid>
            <local:TemperatureRangeSlider NightValue="{Binding NightColorTemp, Mode=TwoWay}"
                                           DayValue="{Binding DayColorTemp, Mode=TwoWay}" Margin="0,4,0,0" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource ThemeSecondaryText}">
                    <Run Text="WARM " />
                    <Run Text="{Binding NightColorTemp, StringFormat={}{0} K}" />
                </TextBlock>
                <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="11"
                           Foreground="{DynamicResource ThemeSecondaryText}">
                    <Run Text="COOL " />
                    <Run Text="{Binding DayColorTemp, StringFormat={}{0} K}" />
                </TextBlock>
            </Grid>

            <TextBlock Text="Morning transition (warm → cool)" Style="{StaticResource SectionHeader}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Start" />
                    <local:TimePicker Time="{Binding MorningStart, Mode=TwoWay}"
                                      Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="End" />
                    <local:TimePicker Time="{Binding MorningEnd, Mode=TwoWay}"
                                      Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
            <TextBlock Text="The screen cools from the warm value back up to the cool value between these times."
                       Foreground="{DynamicResource ThemeSecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap" />

            <TextBlock Text="Evening transition (cool → warm)" Style="{StaticResource SectionHeader}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Start" />
                    <local:TimePicker Time="{Binding EveningStart, Mode=TwoWay}"
                                      Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="End" />
                    <local:TimePicker Time="{Binding EveningEnd, Mode=TwoWay}"
                                      Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
            <TextBlock Text="The screen warms from the cool value down to the warm value between these times."
                       Foreground="{DynamicResource ThemeSecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap" />

            <TextBlock Text="Startup" Style="{StaticResource SectionHeader}" />
            <CheckBox Content="Run Moonglow when I sign in"
                      IsChecked="{Binding RunAtStartup, Mode=TwoWay}"
                      IsEnabled="{Binding CanChangeRunAtStartup}" />
            <TextBlock Text="{Binding RunAtStartupStatus}"
                       Foreground="{DynamicResource ThemeSecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap" />

            <Expander Margin="0,8,0,0" IsExpanded="False">
                <Expander.Header>
                    <TextBlock Text="Keyboard shortcuts" FontSize="13" FontWeight="SemiBold" />
                </Expander.Header>
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Global keys that work from any application. Temperature shortcuts do nothing while automatic color temperature is on. Click a shortcut to change it, then press the new combination; press Delete to turn it off."
                                   Foreground="{DynamicResource ThemeSecondaryText}" TextWrapping="Wrap" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Increase brightness" />
                                <TextBlock Text="Brightness +5%" FontSize="11" Foreground="{DynamicResource ThemeSecondaryText}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Clear" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    IsEnabled="{Binding HasIncreaseBrightnessHotkey}"
                                    Click="ClearHotkey_Click" Tag="{x:Static core:HotkeySlot.IncreaseBrightness}" />
                            <Button Grid.Column="2" Content="{Binding IncreaseBrightnessHotkeyText}" MinWidth="130" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Click="RecordHotkey_Click" Tag="{x:Static core:HotkeySlot.IncreaseBrightness}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Decrease brightness" />
                                <TextBlock Text="Brightness -5%" FontSize="11" Foreground="{DynamicResource ThemeSecondaryText}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Clear" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    IsEnabled="{Binding HasDecreaseBrightnessHotkey}"
                                    Click="ClearHotkey_Click" Tag="{x:Static core:HotkeySlot.DecreaseBrightness}" />
                            <Button Grid.Column="2" Content="{Binding DecreaseBrightnessHotkeyText}" MinWidth="130" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Click="RecordHotkey_Click" Tag="{x:Static core:HotkeySlot.DecreaseBrightness}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Increase temperature (cooler)" />
                                <TextBlock Text="+250 K" FontSize="11" Foreground="{DynamicResource ThemeSecondaryText}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Clear" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    IsEnabled="{Binding HasIncreaseTemperatureHotkey}"
                                    Click="ClearHotkey_Click" Tag="{x:Static core:HotkeySlot.IncreaseTemperature}" />
                            <Button Grid.Column="2" Content="{Binding IncreaseTemperatureHotkeyText}" MinWidth="130" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Click="RecordHotkey_Click" Tag="{x:Static core:HotkeySlot.IncreaseTemperature}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Decrease temperature (warmer)" />
                                <TextBlock Text="-250 K" FontSize="11" Foreground="{DynamicResource ThemeSecondaryText}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Clear" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    IsEnabled="{Binding HasDecreaseTemperatureHotkey}"
                                    Click="ClearHotkey_Click" Tag="{x:Static core:HotkeySlot.DecreaseTemperature}" />
                            <Button Grid.Column="2" Content="{Binding DecreaseTemperatureHotkeyText}" MinWidth="130" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Click="RecordHotkey_Click" Tag="{x:Static core:HotkeySlot.DecreaseTemperature}" />
                        </Grid>
                        <TextBlock Text="{Binding HotkeyMessage}" Foreground="{DynamicResource ThemeSecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <Button Content="Reset defaults" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,5" Click="ResetHotkeys_Click" />
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Margin="0,8,0,0" IsExpanded="False">
                <Expander.Header>
                    <TextBlock Text="Detected displays" FontSize="13" FontWeight="SemiBold" />
                </Expander.Header>
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Displays}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,3" TextWrapping="Wrap"
                                               Foreground="{DynamicResource ThemeStrongText}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Refresh displays" Command="{Binding RefreshCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,5" />
                    </StackPanel>
                </Border>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</Window>

