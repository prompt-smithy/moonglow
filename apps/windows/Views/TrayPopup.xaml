<UserControl x:Class="Moonglow.Views.TrayPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Border Width="300" CornerRadius="10" Background="{DynamicResource ThemeCardBackground}"
            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Moonglow" Foreground="{DynamicResource ThemePrimaryText}" FontSize="15" FontWeight="SemiBold" />

            <DockPanel Margin="0,16,0,0">
                <TextBlock Text="Brightness" Foreground="{DynamicResource ThemeSecondaryText}" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="{Binding BrightnessDisplayText}" Foreground="{DynamicResource ThemeSecondaryText}"
                               HorizontalAlignment="Right" />
                    <Button Content="ⓘ" Width="24" Height="22" Margin="6,-4,0,0" Padding="0"
                            Visibility="{Binding ShowBrightnessInfoButton, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="{Binding BrightnessStatus}" Click="BrightnessInfo_Click" />
                </StackPanel>
            </DockPanel>
            <Slider x:Name="BrightnessSlider" Margin="0,4,0,0" Minimum="{Binding BrightnessMinimum}" Maximum="100"
                    TickPlacement="BottomRight" Ticks="50" IsSnapToTickEnabled="False"
                    IsEnabled="{Binding BrightnessControlEnabled}"
                    ToolTip="{Binding BrightnessStatus}"
                    Value="{Binding Brightness, Mode=OneWay}"
                    IsMoveToPointEnabled="True"
                    ValueChanged="BrightnessSlider_ValueChanged">
                <Slider.Style>
                    <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SplitBrightnessControls}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Slider.Style>
            </Slider>
            <Expander Margin="0,4,0,0" IsExpanded="{Binding SplitBrightnessControls, Mode=TwoWay}">
                <Expander.Header>
                    <TextBlock Text="Split hardware and software controls" FontSize="11"
                               Foreground="{DynamicResource ThemeSecondaryText}" />
                </Expander.Header>
                <StackPanel Margin="0,2,0,0">
                    <TextBlock Text="Hardware backlight" FontSize="10" Foreground="{DynamicResource ThemeSecondaryText}" />
                    <Slider x:Name="HardwareBrightnessSlider" Minimum="1" Maximum="100" Margin="0,1,0,4"
                            IsEnabled="{Binding HardwareBrightnessControlEnabled}"
                            ToolTip="{Binding BrightnessStatus}"
                            Value="{Binding HardwareBrightness, Mode=OneWay}"
                            IsMoveToPointEnabled="True"
                            ValueChanged="HardwareBrightnessSlider_ValueChanged" />
                    <TextBlock Text="Digital shade" FontSize="10" Foreground="{DynamicResource ThemeSecondaryText}" />
                    <Slider x:Name="SoftwareBrightnessSlider" Minimum="{Binding SoftwareBrightnessMinimum}" Maximum="100" Margin="0,1,0,0"
                            IsEnabled="{Binding SoftwareBrightnessControlEnabled}"
                            ToolTip="{Binding BrightnessStatus}"
                            Value="{Binding SoftwareBrightness, Mode=OneWay}"
                            IsMoveToPointEnabled="True"
                            ValueChanged="SoftwareBrightnessSlider_ValueChanged" />
                </StackPanel>
            </Expander>

            <DockPanel Margin="0,16,0,0">
                <TextBlock Text="Color temperature" Foreground="{DynamicResource ThemeSecondaryText}" DockPanel.Dock="Left" />
                <TextBlock Text="{Binding ColorTemperature, StringFormat={}{0}K}" Foreground="{DynamicResource ThemeSecondaryText}"
                           DockPanel.Dock="Right" HorizontalAlignment="Right" />
            </DockPanel>
                <Slider Margin="0,4,0,0" Background="{DynamicResource TemperatureRangeGradient}"
                    Minimum="900" Maximum="6600"
                    TickFrequency="100" IsSnapToTickEnabled="True"
                    IsMoveToPointEnabled="True"
                    IsEnabled="{Binding ManualColorEnabled}"
                    Value="{Binding ColorTemperature, Mode=OneWay}"
                    ValueChanged="ColorTempSlider_ValueChanged" />
                <!-- Endpoint labels keep the direction unambiguous even while the screen
                     itself is tinted by the active temperature. -->
                <Grid Margin="0,2,0,0">
                    <TextBlock Text="WARM 900 K" FontSize="10" HorizontalAlignment="Left"
                               Foreground="{DynamicResource ThemeSecondaryText}" />
                    <TextBlock Text="COOL 6600 K" FontSize="10" HorizontalAlignment="Right"
                               Foreground="{DynamicResource ThemeSecondaryText}" />
                </Grid>

            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <TextBlock Text="Follow color temperature schedule" Foreground="{DynamicResource ThemePrimaryText}"
                           VerticalAlignment="Center" DockPanel.Dock="Left" />
                <ToggleButton Style="{StaticResource SwitchToggle}" Width="40" Height="22"
                              DockPanel.Dock="Right"
                              ToolTip="Change color temperature gradually using the daily schedule"
                              IsChecked="{Binding AutoColorTemperature, Mode=TwoWay}" />
            </DockPanel>

            <Button Content="Schedule settings" Margin="0,16,0,0" Padding="10,6" HorizontalAlignment="Stretch"
                    Foreground="{DynamicResource ThemePrimaryText}" Background="{DynamicResource ThemeControlBackground}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                    Command="{Binding OpenSettingsCommand}" />
        </StackPanel>
    </Border>
</UserControl>

