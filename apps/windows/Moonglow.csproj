<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Moonglow</RootNamespace>
    <AssemblyName>Moonglow</AssemblyName>
    <ApplicationIcon>..\..\resources\Moonglow.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Moonglow</Product>
    <AssemblyTitle>Moonglow</AssemblyTitle>
    <!-- AnyCPU runs 64-bit on 64-bit Windows (as the old win-x64 build did) and still runs on
         32-bit Windows. Prefer32Bit would force a 32-bit process on 64-bit Windows. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <!-- .NET Framework apps are framework-dependent by definition: the runtime is a Windows
       component rather than something we ship. app.config redirects are generated so the NuGet
       dependencies resolve to the versions we compile against. -->
  <PropertyGroup>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools\PortableLauncher\**\*.cs" />
    <!-- Separate projects: the default glob would otherwise compile them into the app too. -->
    <Compile Remove="Moonglow.Core\**\*.cs" />
    <Compile Remove="Moonglow.Core.Tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure settings, schedule, kelvin, and range logic, shared with the conformance tests. -->
    <ProjectReference Include="Moonglow.Core\Moonglow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-time only: supplies the .NET Framework 4.8 reference assemblies so the project
         builds with nothing but the .NET SDK (no Visual Studio or Developer Pack needed). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ships with .NET Framework itself; not a NuGet package on net48. -->
    <Reference Include="System.Management" />
  </ItemGroup>

  <!-- Single command that builds the portable launcher and installer. Run with:
         dotnet build -t:PackageAll -->
  <Target Name="PackageAll">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build.ps1&quot;" />
  </Target>

</Project>


